# /etc/caddy/Caddyfile. Caddy gets and renews the HTTPS certificate by itself.
# Replace amarcircular.com if the domain changes, then: sudo systemctl reload caddy

# Traffic arrives through Cloudflare's proxy (DNS on Cloudflare since 2026-11-24). Trust Cloudflare's ranges
# (https://www.cloudflare.com/ips/) so {client_ip} is the real visitor from CF-Connecting-IP.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.amarcircular.com {
	redir https://amarcircular.com{uri} permanent
}

amarcircular.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Narrow policy that cannot break Next.js or the PDF viewer: no injected <base>, no form posts to other sites.
		# (Framing is already refused by X-Frame-Options. A full script policy needs per-request nonces in Next.js.)
		Content-Security-Policy "base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}

	# The app never uses next/image. Its image optimiser has known remote-code-execution advisories in
	# Next.js 14 (fixed only in 15.5+), so the route stays closed.
	@nextimage path /_next/image*
	handle @nextimage {
		respond 404
	}

	# The interactive API docs and schema stay off the public site.
	@apidocs path /api/v1/docs* /api/v1/redoc* /api/v1/openapi.json
	handle @apidocs {
		respond 404
	}

	# The backend (uvicorn, trusting 127.0.0.1) reads the visitor from X-Forwarded-For, so send only the real
	# visitor address; otherwise sign-in limits would count every visitor as one Cloudflare address.

	# The API and its file downloads. Uploads of circular PDFs can be large.
	handle /api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /health {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /var/log/caddy/regwatch.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
