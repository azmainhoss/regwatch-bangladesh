[Unit]
Description=RegWatch frontend (Next.js standalone)
After=network-online.target regwatch-backend.service

[Service]
User=regwatch
Group=regwatch
WorkingDirectory=/opt/regwatch/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
MemoryMax=500M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/regwatch/web

[Install]
WantedBy=multi-user.target
