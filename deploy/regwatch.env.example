# Amar Circular production settings for the one server (copy to /opt/regwatch/app/.env, chmod 600).
# Every value marked CHANGE must be set before the first start. Never commit the real file.

ENVIRONMENT=production
DEBUG=false

# CHANGE: a private random value of 64+ characters, e.g. `openssl rand -hex 48`.
# Changing it later signs everyone out.
SECRET_KEY=CHANGE_ME

# One server, one SQLite file and the PDFs on its disk (absolute paths).
DATABASE_URL=sqlite+aiosqlite:////opt/regwatch/app/data/regwatch.db
SYNC_DATABASE_URL=sqlite:////opt/regwatch/app/data/regwatch.db
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/opt/regwatch/app/storage

# CHANGE: the domain. The browser calls the API on the same domain (Caddy sends /api/ to the backend).
ALLOWED_ORIGINS=https://amarcircular.com,https://www.amarcircular.com
APP_PUBLIC_URL=https://amarcircular.com

# The checker, page reader and alerts run inside this one backend process. Never on a second machine.
SCHEDULER_ENABLED=true
SEED_ON_STARTUP=false
# Check bb.org.bd every hour, 09:00-19:00 Bangladesh time, full-list check at 18:50.
MONITOR_WINDOW_START=9
MONITOR_WINDOW_END=19
POLL_INTERVAL_WORKDAY_MINUTES=60
POLL_INTERVAL_WEEKEND_MINUTES=60
RECONCILE_TIME=18:50
BB_CRAWLER_USER_AGENT=NoticeIndexBot/0.1

# Page reading (Gemini 3.5 Flash-Lite, free tier). CHANGE: one key, plus optional extra keys, comma separated.
VISION_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=CHANGE_ME
GEMINI_EXTRA_API_KEYS=

# Analysis, Phase 1: done on the laptop and uploaded (no AI key needed here for summaries).
# CHANGE: a private random token of 40+ characters, also set on the laptop as REGWATCH_UPLOAD_TOKEN.
ANALYSIS_PROVIDER=mock
ANALYSIS_AUTO_ENABLED=false
ANALYSIS_UPLOAD_TOKEN=CHANGE_ME
# "Ask a question" answers come from Gemini Flash-Lite (quotes only from the circulars, each with its page).
ANSWER_PROVIDER=gemini

# Email (Brevo free, SMTP on port 587). Leave SMTP_HOST empty until Brevo is set up: email then stays off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Amar Circular
SMTP_TLS_MODE=starttls
