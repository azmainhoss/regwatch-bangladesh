# ==============================================================================
# RegWatch Bangladesh - Backend Environment Configuration Template (Zero-Cost Policy)
# ==============================================================================
# Copy this file to `backend/.env` (or root `.env`) and populate your Google AI Studio key.
# Note: Google AI Studio Free Tier provides free access without billing activation.
# DO NOT enable billing or commit your actual API key to version control.

# AI Provider Configuration
# Options: "mock" (offline heuristic engine) or "gemini" (Google AI Studio Free Tier)
AI_PROVIDER=gemini

# Google AI Studio Free-Tier API Key
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY_HERE

# Free-Tier Eligible Model
# Supported: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Operational Parameters
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3


# Alerts and email (leave SMTP_HOST and SMTP_FROM empty to keep email off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="RegWatch Bangladesh"
# starttls, ssl or none (none is only for a relay on this machine)
SMTP_TLS_MODE=starttls
# Base address for links inside emails
APP_PUBLIC_URL=http://localhost:3000
# Run the alerts job (emails, deadline checks) in this process. One process only.
ALERTS_WORKER_ENABLED=false
