# ==============================================================================
# RegWatch Bangladesh - Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
APP_NAME="RegWatch Bangladesh"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production (PostgreSQL with pgvector):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/regwatch"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regwatch"
# Local SQLite fallback for testing/zero-dependency development:
# DATABASE_URL="sqlite+aiosqlite:///./data/regwatch.db"
# SYNC_DATABASE_URL="sqlite:///./data/regwatch.db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Document Storage
# driver options: local, s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./storage"
ORIGINALS_STORAGE_NAMESPACE="originals"
EVIDENCE_STORAGE_NAMESPACE="evidence"

# S3 Configuration (if STORAGE_DRIVER=s3)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="regwatch-documents"
S3_REGION="ap-southeast-1"

# Page reading (DECISIONS.md 6 and 10)
# English text-layer pages are read locally. Bangla, legacy-font and scanned pages are read
# by Gemini from a page image, one call at a time, in a background job (needs GEMINI_API_KEY).
VISION_MODEL="gemini-3.5-flash-lite"
VISION_DPI=200
VISION_MAX_RETRIES=4
VISION_MAX_ATTEMPTS=5
VISION_POLL_SECONDS=60
# Run the page-reading job in this process (it also runs wherever SCHEDULER_ENABLED is on).
VISION_WORKER_ENABLED=false
MAX_PAGE_PROCESSING_TIMEOUT_SEC=60

# Circular analysis model (swap by config only)
# ANALYSIS_PROVIDER: mock | gemini | openai_compat
ANALYSIS_PROVIDER="mock"
# Model id. Empty = provider default (gemini: GEMINI_ANALYSIS_DEFAULT_MODEL). Required for openai_compat.
ANALYSIS_MODEL=""
GEMINI_ANALYSIS_DEFAULT_MODEL="gemini-3.5-flash"
# One key is enough for both page reading and analysis.
GEMINI_API_KEY=""
# Any chat-completions server: OpenRouter, SambaNova, a local llama.cpp/vLLM/Ollama server, ...
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_API_KEY=""
# json_object | json_schema | none
OPENAI_COMPAT_RESPONSE_FORMAT="json_object"
# Retries on 429/5xx/network errors, waiting 5 s, 10 s, 20 s ... (capped), then a clear failure.
AI_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=5
AI_RETRY_MAX_SECONDS=120
AI_TIMEOUT_SECONDS=120

# Talking to bb.org.bd: own name, one request at a time, at least 15 s apart
BB_CRAWLER_USER_AGENT="RegWatchBot/0.1"
BB_REQUEST_INTERVAL_SECONDS=15
BB_POLL_DAYS=7
BB_BACKOFF_START_MINUTES=30
BB_BACKOFF_MAX_MINUTES=360

# Monitoring schedule (local time in MONITOR_TIMEZONE). Nothing runs outside the window.
MONITOR_TIMEZONE=Asia/Dhaka
MONITOR_WINDOW_START=10
MONITOR_WINDOW_END=18
POLL_INTERVAL_WORKDAY_MINUTES=10
POLL_INTERVAL_WEEKEND_MINUTES=60
RECONCILE_TIME=17:50
# Weekly archive re-check. Weekday: Mon=0 ... Fri=4, Sat=5, Sun=6.
RECHECK_WEEKDAY=4
RECHECK_TIME=11:00

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security and startup
# JWT signing key (JWT_SECRET is accepted as an alias). Required when ENVIRONMENT=production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma separated list of exact frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Load the demo seed (includes demo logins) into an empty database at startup. Ignored in production.
SEED_ON_STARTUP=false
# Run the source monitoring scheduler in this process. Set false on all but one process.
SCHEDULER_ENABLED=false

# Frontend (read by Next.js at build time)
# Public URL of this API as the browser sees it. Defaults to http://localhost:8000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
