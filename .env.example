# ==============================================================================
# RegWatch Bangladesh - Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
APP_NAME="RegWatch Bangladesh"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production (PostgreSQL with pgvector):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/regwatch"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regwatch"
# Local SQLite fallback for testing/zero-dependency development:
# DATABASE_URL="sqlite+aiosqlite:///./data/regwatch.db"
# SYNC_DATABASE_URL="sqlite:///./data/regwatch.db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Document Storage
# driver options: local, s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./storage"
ORIGINALS_STORAGE_NAMESPACE="originals"
EVIDENCE_STORAGE_NAMESPACE="evidence"

# S3 Configuration (if STORAGE_DRIVER=s3)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="regwatch-documents"
S3_REGION="ap-southeast-1"

# OCR and Extraction
TESSERACT_CMD="/opt/homebrew/bin/tesseract"
TESSDATA_PREFIX="/opt/homebrew/share/tessdata"
OCR_DEFAULT_LANG="ben+eng"
MAX_PAGE_PROCESSING_TIMEOUT_SEC=60

# AI Provider Configuration (Vendor Agnostic)
# Available providers: gemini, openai, anthropic, mock
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_AI_MODEL="gemini-2.0-flash"
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# Rate Limiting & Crawling
BB_CRAWLER_USER_AGENT="RegWatch-Bangladesh-ResearchBot/1.0 (+compliance-research@regwatch.bd)"
BB_REQUEST_INTERVAL_SECONDS=3.0
MAX_CONCURRENT_DOWNLOADS=2

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
